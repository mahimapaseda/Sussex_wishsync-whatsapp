<Window x:Class="SheetPulse.Desktop.ManualSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Send Birthday Wish — Sussex College Network"
        Height="620" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Manual Birthday Dispatch" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}"/>
            <TextBlock Text="Direct personalized WhatsApp birthday delivery with greeting card" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Phone -->
                <TextBlock Text="Recipient Phone Number (Sri Lanka: 07XXXXXXXX)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="PhoneTextBox" TextChanged="OnPhoneChanged" Text="" Margin="0,0,0,4"/>
                <TextBlock x:Name="PhoneValidationText" Text="Please enter a valid phone number" FontSize="11" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,0,12"/>

                <!-- Name -->
                <TextBlock Text="Student / Child Name" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="NameTextBox" Text="Little Sunshine" TextChanged="OnDetailsChanged" Margin="0,0,0,12"/>

                <!-- Branch -->
                <TextBlock Text="Sussex Network Branch" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="BranchComboBox" SelectionChanged="OnBranchSelectionChanged" Background="{StaticResource CardSubtleBrush}" Foreground="Black" Padding="6" Margin="0,0,0,12"/>

                <!-- Greeting Card Thumbnail -->
                <Border Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="CardThumbnailImage" Width="60" Height="60" Stretch="UniformToFill" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Birthday Greeting Card Attached" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentGreenBrush}"/>
                            <TextBlock x:Name="CardPathText" Text="data/assets/birthday-card.jpeg" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Message Preview -->
                <TextBlock Text="Message Caption" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="MessageTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClicked" Width="90" Margin="0,0,10,0"/>
            <Button x:Name="SendButton" Content="Send Wish" Click="OnSendClicked" Background="{StaticResource AccentGreenBrush}" Foreground="White" Width="120"/>
        </StackPanel>
    </Grid>
</Window>
