<Window x:Class="SheetPulse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SheetPulse — Sussex College Network Birthday Dispatch Engine"
        Height="780" Width="1120"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Countdown Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Stat Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Branch Filter Pills -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Roster + Upcoming + Ledger) -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E3A8A" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                        <TextBlock Text="🎓" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SheetPulse" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="#854D0E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="SUSSEX NETWORK" FontSize="9" FontWeight="Bold" Foreground="#FEF08A"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="DateTimeText" Text="10/11/2026 • Asia/Colombo" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Sheets Status -->
                    <Border Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SheetsDot" Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Sheets: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="SheetsStatusText" Text="Connected (681 rows)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- WhatsApp Status -->
                    <Button x:Name="WhatsAppStatusButton" Click="OnWhatsAppStatusClicked" Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="WhatsAppDot" Width="8" Height="8" Fill="{StaticResource AccentGoldBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="WhatsApp: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="WhatsAppStatusText" Text="Initializing..." FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Manual Send" Click="OnManualSendClicked" Background="{StaticResource AccentGoldBrush}" Foreground="Black" FontWeight="Bold" Margin="0,0,8,0"/>
                    <Button Content="Sync Sheets" Click="OnSyncClicked" Margin="0,0,8,0"/>
                    <Button Content="⚙ Settings" Click="OnSettingsClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- COUNTDOWN BANNER -->
        <Border x:Name="CountdownBanner" Grid.Row="1" Background="#78350F" BorderBrush="#D97706" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Automatic Dispatch: " FontWeight="Bold" Foreground="#FEF3C7"/>
                    <TextBlock x:Name="CountdownMessageText" Text="Sending today's birthday wishes in 10s..." Foreground="#FEF3C7"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Click="OnCancelCountdownClicked" Margin="0,0,8,0" Background="#92400E" Foreground="White"/>
                    <Button Content="Send Now" Click="OnSendNowCountdownClicked" Background="{StaticResource AccentGreenBrush}" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUMMARY STAT CARDS -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Today's Birthdays -->
            <Border Grid.Column="0" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="TODAY'S CELEBRATIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="StatTodayCount" Text="0" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Pending Wishes -->
            <Border Grid.Column="1" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="PENDING WISHES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}"/>
                    <TextBlock x:Name="StatPendingCount" Text="0" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource AccentGoldBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Delivered Today -->
            <Border Grid.Column="2" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="DELIVERED TODAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                    <TextBlock x:Name="StatDeliveredCount" Text="0" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Upcoming 7 Days -->
            <Border Grid.Column="3" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="UPCOMING (7 DAYS)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                    <TextBlock x:Name="StatUpcomingCount" Text="0" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BRANCH FILTER BAR -->
        <Border Grid.Row="3" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,12">
            <WrapPanel x:Name="BranchFilterPanel" Orientation="Horizontal"/>
        </Border>

        <!-- MAIN SPLIT WORKSPACE -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <!-- Students Today (60%) -->
                <ColumnDefinition Width="6*"/>
                <!-- Upcoming & Ledger (40%) -->
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Today's Birthdays List -->
            <Border Grid.Column="0" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="🎉 Students Celebrating Today" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Background="{StaticResource CardSubtleBrush}" CornerRadius="10" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock x:Name="TodayListBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}"/>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Empty Placeholder -->
                            <Border x:Name="TodayEmptyState" Background="{StaticResource CardSubtleBrush}" CornerRadius="8" Padding="20" HorizontalAlignment="Stretch" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="No student birthdays found for today in selected branch." TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            </Border>

                            <!-- Items Control -->
                            <ItemsControl x:Name="TodayStudentsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Branch}" FontSize="10" Foreground="#93C5FD"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding PhoneDisplay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding DobFormatted, StringFormat='DOB: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}"/>
                                                    </Border>
                                                    <Button Content="Send Wish" Tag="{Binding}" Click="OnSendStudentWishClicked" Background="{StaticResource AccentGreenBrush}" Foreground="White" FontSize="11" Padding="10,4"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: Upcoming Birthdays & Ledger -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <!-- Upcoming (50%) -->
                    <RowDefinition Height="5*"/>
                    <!-- Ledger (50%) -->
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>

                <!-- UPCOMING (7 DAYS) -->
                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📅 Upcoming Birthdays (Next 7 Days)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="UpcomingItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Branch}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DaysUntil, StringFormat='In {0} days'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- LOCAL DELIVERY LEDGER -->
                <Border Grid.Row="1" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,6,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="📜 Sent Delivery Ledger" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Content="Export CSV" Click="OnExportLedgerClicked" HorizontalAlignment="Right" FontSize="10" Padding="8,3"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LedgerItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardSubtleBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding DateSent}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="Delivered" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <TextBlock Grid.Row="5" Text="SheetPulse Birthday Wisher • Sussex Education Group • Low-RAM Desktop Engine" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>

        <!-- HIDDEN WEBVIEW2 (WhatsApp Web Automation Engine) -->
        <wv2:WebView2 x:Name="HiddenWebView" Grid.Row="5" Width="0" Height="0" Visibility="Collapsed"/>
    </Grid>
</Window>
