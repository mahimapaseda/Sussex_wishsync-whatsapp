{
  "name": "@mahimapaseda/wishsync",
  "version": "1.2.0",
  "description": "WishSync — Automated Birthday Dispatch Software for Google Sheets & WhatsApp",
  "main": "electron/main.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahimapaseda/Sussex_wishsync-whatsapp.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "electron/**/*",
    "src/**/*",
    "data/settings.json",
    "data/sample_students.csv",
    "data/assets/**/*",
    "build/**/*",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "electron": "electron .",
    "dev": "node --watch src/index.js",
    "test": "node test/test-matcher.js && node test/test-whatsapp-send.js && node test/test-updater.js",
    "build:exe": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:release": "electron-builder --win"
  },
  "keywords": [
    "whatsapp",
    "google-sheets",
    "birthday-wisher",
    "automation",
    "startup"
  ],
  "author": "Mahima Paseda (www.mahimapaseda.lk)",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "open": "^10.1.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "lk.sussex.wishsync",
    "productName": "WishSync",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "data/settings.json",
      "data/sample_students.csv",
      "data/assets/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "protocols": {
        "name": "WishSync Protocol",
        "schemes": ["wishsync"]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "shortcutName": "WishSync",
      "runAfterFinish": true
    }
  }
}
