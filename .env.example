# SheetPulse Birthday Wisher Configuration

# Server
PORT=3847
TIMEZONE=Asia/Colombo
OPEN_BROWSER_ON_BOOT=true

# Google Sheets Configuration
# The ID from your Google Sheets URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_google_spreadsheet_id_here
# Sheet Tab Name (e.g. INQUIRY DETAILS 2026/27). Multiple sheets can be comma-separated.
SHEET_NAME=INQUIRY DETAILS 2026/27
# Path to downloaded Service Account JSON credentials
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Fallback to local sample CSV if credentials.json is not configured
DATA_SOURCE_FALLBACK=true

# WhatsApp Configuration
WHATSAPP_CLIENT_ID=sheetpulse-session
# Auto send on Windows boot with a countdown
AUTO_SEND_ON_BOOT=true
AUTO_SEND_DELAY_SECONDS=10
# Anti-ban randomized delay between messages in milliseconds (5-12 seconds)
MIN_DISPATCH_DELAY_MS=5000
MAX_DISPATCH_DELAY_MS=12000

# Birthday Message Template
# Available placeholders: {name}, {first_name}, {branch}, {age}
DEFAULT_TEMPLATE=Dear {name}, on behalf of Sussex, we wish you a very Happy Birthday! 🎂🎉 May this special day bring you immense joy, happiness, and great success ahead!

